# Copy to backend/.env. Every service below has a free tier.

# ── AI ── set one or both; AI_PROVIDER goes first, the other takes over when it's rate-limited
# https://console.groq.com/keys  |  https://aistudio.google.com/apikey
GROQ_API_KEY=
# GROQ_MODEL=openai/gpt-oss-120b
GEMINI_API_KEY=
# GEMINI_MODEL=gemini-flash-latest
# AI_FALLBACK_MODELS=gemini-flash-lite-latest   # tried when the main model is overloaded
# AI_PROVIDER=groq            # groq | gemini | openai
# AI_REASONING_EFFORT=low     # set empty for models that don't support it

# ── Market data ──
FINNHUB_API_KEY=
TWELVEDATA_API_KEY=
SEC_USER_AGENT=StockInsights you@example.com   # SEC EDGAR requires contact info

# ── App ──
JWT_SECRET=change-me-to-a-long-random-string-32+chars
CORS_ORIGINS=http://localhost:5173,http://localhost:5174
# DATABASE_URL=postgresql://...   # omit to use local SQLite

# ── Alerts & briefing ──
PRICE_CHANGE_ALERT=5.0
VOLUME_SPIKE_ALERT=2.0
# SCHEDULER_ENABLED=1
# ALERT_SCAN_MINUTES=15
# BRIEFING_HOUR_ET=8
# NTFY_SERVER=https://ntfy.sh

# ── Error tracking (optional, free at sentry.io) ──
# SENTRY_DSN=                 # backend (Render env var)
# SENTRY_ENVIRONMENT=production
# VITE_SENTRY_DSN=            # frontend (Vercel env var; use the browser project's DSN)
