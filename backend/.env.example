# AI Provider: "groq" (default, free), "gemini", or "openai"
AI_PROVIDER=groq
GROQ_API_KEY=your_groq_api_key_here
# Optional: Gemini
# GEMINI_API_KEY=your_gemini_api_key_here
# Optional: OpenAI
# OPENAI_API_KEY=your_openai_api_key_here
# OPENAI_MODEL=gpt-4o-mini
NEWS_API_KEY=your_newsapi_key_here
CORS_ORIGINS=http://localhost:5173,http://localhost:5174
PRICE_CHANGE_ALERT=5.0
VOLUME_SPIKE_ALERT=2.0
# Optional: Alpaca free market data, used as a backup for stock history and quotes
# ALPACA_API_KEY_ID=your_alpaca_key_id
# ALPACA_API_SECRET_KEY=your_alpaca_secret
